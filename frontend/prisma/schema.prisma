generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Kimlik ──────────────────────────────────────────────

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         String       @default("USER")
  createdAt    DateTime     @default(now())
  projectLogs  ProjectLog[]
  permissions  UserPagePermission[]
}

// Kullanıcı bazlı sayfa erişim/düzenleme yetkileri. Bir kullanıcı için bir sayfada
// hiç kayıt yoksa, o sayfanın varsayılan politikası uygulanır (bkz. src/lib/permissions.ts
// DEFAULT_EDIT) — böylece bu sistem devreye girmeden önceki davranış korunur.
model UserPagePermission {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  page    String
  canView Boolean @default(true)
  canEdit Boolean @default(false)

  @@unique([userId, page])
}

// ── Ortak ───────────────────────────────────────────────

model Factory {
  id             String          @id @default(cuid())
  name           String          @unique
  location       String?
  projects       Project[]
  licenses       License[]
  capexMainItems CapexMainItem[]
}

model TeamMember {
  id          String       @id @default(cuid())
  name        String
  title       String?
  active      Boolean      @default(true)
  assignments Assignment[]
  taskAssignees TaskAssignee[]
}

// ── Modül 1: Proje ve Kaynak Yönetimi ──────────────────

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

// Proje / demand kapsamı dışındaki işler (Lead, CR) ile normal projeleri ayırt eder.
// Aynı Project modelini ve tüm alt yapısını (plan, ödeme, efor, bütçe) paylaşırlar,
// yalnızca ayrı bir menüde listelenir ve risk/öncelik alanları kullanılmaz.
enum ProjectKind {
  PROJECT
  LEAD
  CR
}

model Project {
  id           String        @id @default(cuid())
  kind         ProjectKind   @default(PROJECT)
  projectCode  String        @unique
  pipelineCode String? // Pipeline Kodu (PTM)
  name         String
  factories    Factory[]
  probability  Int           @default(50) // gerçekleşme ihtimali (%)
  targetBudget Decimal       @default(0) @db.Decimal(14, 2)
  startDate    DateTime?
  endDate      DateTime?
  riskLevel    RiskLevel     @default(MEDIUM)
  priority     Priority      @default(MEDIUM)
  status       ProjectStatus @default(PLANNED)
  description  String?
  jiraLink     String? // JIRA proje/epic linki — proje detay sayfasında başlığın altında gösterilir
  paymentPlanNote String? // Ödeme Planı — serbest metin açıklama (ayrı bir modül/tablo yerine proje bilgisi olarak tutulur)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  logs            ProjectLog[]
  assignments     Assignment[]
  budgetItems     BudgetItem[]
  financials      MonthlyFinancial[]
  invoices        Invoice[]
  paymentPlanItems PaymentPlanItem[]
  tasks           ProjectTask[]
  capexSubItems   CapexSubItem[]
}

// Tarihsel değişiklik logu
model ProjectLog {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

// Aylık bazda adam-gün planı ve gerçekleşen
model Assignment {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId    String
  member      TeamMember @relation(fields: [memberId], references: [id])
  year        Int
  month       Int // 1-12
  plannedDays Decimal    @default(0) @db.Decimal(6, 2)
  actualDays  Decimal    @default(0) @db.Decimal(6, 2)
  resources   String? // kullanılacak kaynaklar

  @@unique([projectId, memberId, year, month])
  @@index([year, month])
}

// ── Modül 2: Bütçe ve Finansal Yönetim ─────────────────

// Kalemlerin girildiği para birimi. TL'ye çevrim TCMB kuru ile yapılır.
enum Currency {
  TRY
  USD
  EUR
  GBP
}

// Yatırım (CAPEX) mı işletme gideri (OPEX) mi
enum BudgetExpenseType {
  CAPEX
  OPEX
}

// Kırılımlı bütçe / teklif kalemleri
model BudgetItem {
  id                 String            @id @default(cuid())
  projectId          String
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  year               Int               @default(2026) // bütçe kalemi hangi yıla ait
  expenseType        BudgetExpenseType @default(CAPEX)
  category           String // örn. Donanım, Yazılım, İşçilik
  description        String
  supplier           String? // Tedarikçi
  unit               String? // Birim (ad, adet, gün, ...)
  quantity           Decimal           @default(1) @db.Decimal(10, 2)
  unitPrice          Decimal           @default(0) @db.Decimal(14, 2)
  amount             Decimal           @default(0) @db.Decimal(14, 2)
  currency           Currency          @default(TRY)
  note               String? // Not
  transferFeePercent Decimal?          @db.Decimal(5, 2) // TF %
  transferPrice      Decimal?          @db.Decimal(14, 2) // TF (Transfer Fiyatı)

  @@index([projectId, year])
}

// Aylık gelir / gider / iç kaynak geliri gridi
// Kural: gelir en az giderin %5 fazlası olmalıdır (income >= expense * 1.05); üzeri manuel girilebilir.
model MonthlyFinancial {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  year           Int
  month          Int // 1-12
  income         Decimal  @default(0) @db.Decimal(14, 2)
  expense        Decimal  @default(0) @db.Decimal(14, 2)
  internalIncome Decimal  @default(0) @db.Decimal(14, 2)
  currency       Currency @default(TRY)

  @@unique([projectId, year, month])
  @@index([year])
}

enum InvoiceStatus {
  PLANNED
  ISSUED
}

// Fatura gider mi gelir mi — aylık finans (Gider/Gelir) buna göre otomatik hesaplanır.
enum InvoiceType {
  EXPENSE
  INCOME
}

// Faturalama takvimi
model Invoice {
  id          String        @id @default(cuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        InvoiceType   @default(INCOME)
  description String
  amount      Decimal       @default(0) @db.Decimal(14, 2)
  currency    Currency      @default(TRY)
  issueDate   DateTime
  status      InvoiceStatus @default(PLANNED)
  ebaNumber   String?
  poNumber    String?
  hasExchangeRateDiff      Boolean @default(false) // Kur farkı oluştu mu
  exchangeRateDiffEbaNumber String? // Kur farkı eBA No

  @@index([issueDate])
}

enum PaymentStatus {
  PLANNED
  PAID
}

// Ödeme Planı — her projenin kendi ödeme takvimini ayrı tutar
model PaymentPlanItem {
  id          String        @id @default(cuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal       @default(0) @db.Decimal(14, 2)
  currency    Currency      @default(TRY)
  dueDate     DateTime
  status      PaymentStatus @default(PLANNED)
  note        String?

  @@index([dueDate])
}

// ── Modül 4: PT Kodları ─────────────────────────────────
// Projelerden ayrı, kendi fatura ve aylık finans takibini yapan PT kayıtları.
// Kurgu: PT karşılığında fatura alınır; giderin %5 fazlası gelir olarak yazılır (Proje modülüyle aynı mantık).

model Pt {
  id           String        @id @default(cuid())
  ptCode       String        @unique
  pipelineCode String? // Pipeline Kodu (PTM)
  name         String
  description String?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  invoices   PtInvoice[]
  financials PtMonthlyFinancial[]
}

// PT faturaları — proje Invoice modeliyle aynı kurgu (eBA No zorunlu, kur farkı takibi)
model PtInvoice {
  id          String        @id @default(cuid())
  ptId        String
  pt          Pt            @relation(fields: [ptId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal       @default(0) @db.Decimal(14, 2)
  currency    Currency      @default(TRY)
  issueDate   DateTime
  status      InvoiceStatus @default(PLANNED)
  ebaNumber   String?
  poNumber    String?
  hasExchangeRateDiff       Boolean @default(false) // Kur farkı oluştu mu
  exchangeRateDiffEbaNumber String? // Kur farkı eBA No

  @@index([issueDate])
}

// PT aylık gelir/gider — gelir en az giderin %5 fazlası olmalıdır (Proje MonthlyFinancial ile aynı kural)
model PtMonthlyFinancial {
  id       String   @id @default(cuid())
  ptId     String
  pt       Pt       @relation(fields: [ptId], references: [id], onDelete: Cascade)
  year     Int
  month    Int
  income   Decimal  @default(0) @db.Decimal(14, 2)
  expense  Decimal  @default(0) @db.Decimal(14, 2)
  currency Currency @default(TRY)

  @@unique([ptId, year, month])
  @@index([year])
}

// ── Modül 3: Lisans ve Key Yönetimi ────────────────────

enum PaymentPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
  ONE_TIME
}

enum LicenseStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  CANCELLED
}

model Application {
  id       String    @id @default(cuid())
  name     String    @unique
  vendor   String?
  licenses License[]
}

model License {
  id               String        @id @default(cuid())
  applicationId    String
  application      Application   @relation(fields: [applicationId], references: [id])
  factories        Factory[]
  licenseKey       String
  description      String?
  totalInvestment  Decimal       @default(0) @db.Decimal(14, 2) // toplam yatırım bedeli
  isSubscription   Boolean       @default(false)
  subscriptionCost Decimal       @default(0) @db.Decimal(14, 2)
  currency         Currency      @default(TRY)
  paymentPeriod    PaymentPeriod @default(ONE_TIME)
  renewalDate      DateTime?
  status           LicenseStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
}

// ── Modül 5: Proje Planı (Gantt) ───────────────────────
// Görev/milestone kırılımı, kişi ataması ve haftalık gün dağılımı.
// Haftalık gün girişleri Assignment (Kaynak Planı) tablosuna otomatik yansıtılır.

enum TaskType {
  TASK
  MILESTONE
}

model ProjectTask {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    ProjectTask?  @relation("TaskChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  ProjectTask[] @relation("TaskChildren")
  title     String
  type      TaskType      @default(TASK)
  color     String        @default("#3b82f6")
  startDate DateTime
  endDate   DateTime
  order     Int           @default(0)
  jiraCode  String? // JIRA görev kodu (örn. PRJ-42) — dolduğunda JIRA'ya link olur; sadece admin düzenler
  jiraLink  String? // JIRA kodunun bağlandığı tam URL
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  assignees TaskAssignee[]

  @@index([projectId])
  @@index([parentId])
}

// Bir görevin bir ekip üyesine ataması
model TaskAssignee {
  id       String     @id @default(cuid())
  taskId   String
  task     ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  memberId String
  member   TeamMember  @relation(fields: [memberId], references: [id])

  weekAllocations TaskWeekAllocation[]

  @@unique([taskId, memberId])
}

// Bir atamanın haftalık gün dağılımı — ilgili ay Assignment.plannedDays'e toplanır
model TaskWeekAllocation {
  id             String       @id @default(cuid())
  taskAssigneeId String
  taskAssignee   TaskAssignee @relation(fields: [taskAssigneeId], references: [id], onDelete: Cascade)
  year           Int
  week           Int // ISO hafta no (1-53)
  days           Decimal      @default(0) @db.Decimal(4, 2)

  @@unique([taskAssigneeId, year, week])
  @@index([year, week])
}

// ── Modül 6: Dijital CAPEX Bütçesi ─────────────────────
// Yıllık onaylanan CAPEX bütçesinin ana kalem → alt proje kırılımı.
// Düzenleme yalnızca admin; herkes interaktif salt-okunur olarak görebilir.

model CapexBudget {
  id          String   @id @default(cuid())
  year        Int      @unique
  currency    Currency @default(TRY)
  title       String?
  totalBudget Decimal  @default(0) @db.Decimal(14, 2) // onaylanan yıllık toplam (0 ise ana kalem toplamı esas alınır)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mainItems CapexMainItem[]
}

model CapexMainItem {
  id            String      @id @default(cuid())
  capexBudgetId String
  capexBudget   CapexBudget @relation(fields: [capexBudgetId], references: [id], onDelete: Cascade)
  factories     Factory[]
  title         String
  budget        Decimal     @default(0) @db.Decimal(14, 2)
  spent         Decimal     @default(0) @db.Decimal(14, 2) // alt proje kırılımı yoksa doğrudan kullanılan tutar
  description   String?
  order         Int         @default(0)

  subItems CapexSubItem[]

  @@index([capexBudgetId])
}

// Bir ana kalemin altındaki proje/kırılım — kendi bütçesi ana kalemden pay alır
model CapexSubItem {
  id         String        @id @default(cuid())
  mainItemId String
  mainItem   CapexMainItem @relation(fields: [mainItemId], references: [id], onDelete: Cascade)
  // Mevcut bir Proje kaydına bağlanabilir (opsiyonel); bağlıysa bu alt kalemin
  // bütçesi (CAPEX bütçesinin para biriminde) güncel TCMB kuruyla TL'ye çevrilip
  // projenin targetBudget alanına otomatik yansıtılır.
  projectId  String?
  project    Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title      String
  budget     Decimal       @default(0) @db.Decimal(14, 2)
  note       String?
  order      Int           @default(0)

  @@index([mainItemId])
  @@index([projectId])
}
